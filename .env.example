# Database. Leave empty locally (uses a data.db file).
# On Render: your Supabase "Session pooler" connection string (Supabase -> Connect).
DATABASE_URL=

# Slack: api.slack.com/apps -> Create app -> Incoming Webhooks -> Add New Webhook
SLACK_WEBHOOK_URL=

# DataForSEO: app.dataforseo.com -> API Dashboard (API login + API password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# 2840 = United States, 2356 = India
DATAFORSEO_LOCATION_CODE=2840
